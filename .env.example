APP_ENV=dev
LOG_LEVEL=debug
PORT=8080
DATABASE_URL=postgres://most:most@localhost:5432/most?sslmode=disable

TELEGRAM_TOKEN=secret
TELEGRAM_MODE=polling
TELEGRAM_BOT_USERNAME=most_files_dev_bot
# Required in webhook mode (TELEGRAM_MODE=webhook):
TELEGRAM_WEBHOOK_SECRET=change-me

# Base URL for the webhook and the OAuth callback. Defaults to
# http://localhost:8080 in dev; required in prod.
PUBLIC_URL=https://your-app.example

# Google OAuth. TOKEN_ENC_KEY is a base64-encoded 32-byte key:
#   openssl rand -base64 32
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
TOKEN_ENC_KEY=
